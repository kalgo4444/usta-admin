{
	"name": "usta-admin",
	"version": "1.2.0",
	"private": true,
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"dev": "node scripts/next.mjs dev",
		"build": "next build",
		"start": "node scripts/next.mjs start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"gen:api": "openapi-typescript \"${API_URL:?Set API_URL to the backend origin}/v3/api-docs\" -o src/shared/api/schema.d.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@hookform/resolvers": "^7.0.9",
		"@tanstack/react-query": "^5.108.4",
		"@tanstack/react-table": "^9.3.1",
		"axios": "^1.21.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"lucide-react": "^1.79.0",
		"next": "16.4.6",
		"next-intl": "^4.16.1",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.8.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.92.0",
		"server-only": "^0.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@tailwindcss/turbopack": "4.3.3",
		"@types/node": "^24.19.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.6",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "^5.9.3",
		"vitest": "^5.1.2"
	}
}
